# $0 Stack Configuration

# 1. Neon Postgres Database URL (Free tier from https://neon.tech)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Groq LLM API Key (Free tier from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
